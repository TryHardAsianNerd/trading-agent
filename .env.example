# Trading Agent environment — copy to .env and fill in. NEVER commit .env.
# All exchange API keys MUST have withdrawal permissions DISABLED.

# --- Trading mode (guardrail) ---
# This public build is paper-only: TRADING_MODE=live is rejected.
TRADING_MODE=paper

# --- Market data ---
FINNHUB_API_KEY=your_finnhub_key_here
# FRED (https://fred.stlouisfed.org/docs/api/api_key.html): VIX close for the Layer-5 filter.
# Without it VIX is unknown and buys are never halved for volatility.
FRED_API_KEY=your_fred_key_here
# CoinGecko free tier needs no key.

# --- Execution (paper/sandbox) ---
ALPACA_API_KEY=your_alpaca_paper_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_here
COINBASE_API_KEY=your_coinbase_sandbox_key_here
COINBASE_API_SECRET=your_coinbase_sandbox_secret_here

# --- LLM analyst ---
ANTHROPIC_API_KEY=your_anthropic_key_here
# Model for the analyst node (optional; defaults to claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Notifications (Discord, D-017) ---
# Bot token from https://discord.com/developers/applications (Bot tab -> Reset Token).
# Channel id + your user id from Discord with Developer Mode on (right-click -> Copy ID).
# Alerts need token + channel; /killswitch, /resume, /status also need the owner id.
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=your_private_channel_id
DISCORD_OWNER_ID=your_discord_user_id

# --- Infrastructure (defaults match docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://trading:trading_dev_only@127.0.0.1:5432/trading_agent
REDIS_URL=redis://127.0.0.1:6379/0
# Background worker queue (a separate Redis db; docker-compose overrides it for the worker container)
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# --- Agent behavior ---
CYCLE_INTERVAL_MINUTES=15
# Starting cash for the simulated crypto paper venue (D-013)
PAPER_STARTING_CASH=10000
STOCK_WATCHLIST=VOO,QQQM,AAPL,MSFT,NVDA,GOOGL,AMZN,META,AVGO,JPM,V,COST,WMT,LLY,XOM
CRYPTO_WATCHLIST=BTC-USD,ETH-USD
